# Trailmate Environment Variables
# Google Places API (New) Key - from Google Cloud Console
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# WeatherAPI.com Key - from weatherapi.com dashboard
WEATHER_API_KEY=your_weather_api_key_here

# Gemini API Key - from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3001
FLIGHT_SERVICE_PORT=5001
NODE_ENV=development
