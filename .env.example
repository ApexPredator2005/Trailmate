# Trailmate Environment Variables
# Google Places API (New) Key - from Google Cloud Console
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# WeatherAPI.com Key - from weatherapi.com dashboard
WEATHER_API_KEY=your_weather_api_key_here

# Gemini API Key - from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Flight APIs (Optional - fallback schedules used if unset)
RAPIDAPI_KEY=your_rapidapi_key_here
SERPAPI_KEY=your_serpapi_key_here

# Stay / Accommodation API (Optional)
STAY_API_KEY=your_stay_api_key_here
STAY_API_URL=https://api.stayapi.com/v1

# Server Configuration
PORT=3001
FLIGHT_SERVICE_PORT=5001
NODE_ENV=development
